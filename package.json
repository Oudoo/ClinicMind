{
  "name": "the-grow-engine",
  "version": "1.0.0",
  "private": true,
  "description": "The Grow Engine — Multi-tenant Growth Intelligence Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:worker",
    "dev:web": "npm run dev --workspace=@growengine/web",
    "dev:worker": "npm run dev --workspace=@growengine/worker",
    "build": "npm run build --workspace=@growengine/db && npm run build --workspace=@growengine/core && npm run build --workspace=@growengine/worker && npm run build --workspace=@growengine/web",
    "start:web": "npm run start --workspace=@growengine/web",
    "start:worker": "npm run start --workspace=@growengine/worker",
    "db:generate": "npm run generate --workspace=@growengine/db",
    "db:migrate": "npm run migrate --workspace=@growengine/db",
    "db:push": "npm run push --workspace=@growengine/db",
    "db:seed": "npm run seed --workspace=@growengine/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace=@growengine/web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
