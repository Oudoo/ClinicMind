{
  "name": "@growengine/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@growengine/db": "1.0.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.86.1",
    "bullmq": "^5.41.5",
    "ioredis": "^5.5.0",
    "zod": "^3.24.2",
    "nodemailer": "^6.10.0",
    "cheerio": "^1.0.0",
    "rss-parser": "^3.13.0",
    "google-auth-library": "^9.15.1",
    "minio": "^8.0.4",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
