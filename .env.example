# ──────────────────────────────────────────────────────────────────────────
# ClinicMind — environment template. Copy to `.env` and fill in.
# ──────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
# Root/apex domain ClinicMind runs on. Tenant subdomains are resolved against this
# (e.g. acme.clinics.example.com -> tenant "acme"). For local dev, use lvh.me.
ROOT_DOMAIN=lvh.me:3000

# Database (PostgreSQL + pgvector). Locally the app connects as the owner and
# row-level security is not enforced (the server log says so). Production
# connects as the app's own role and keeps the owner for cross-clinic work:
#   DATABASE_URL=postgresql://clinicmind_app:<APP_DB_PASSWORD>@…/clinicmind
#   SYSTEM_DATABASE_URL=postgresql://clinicmind:<owner password>@…/clinicmind
# (`APP_DB_PASSWORD=… npx tsx scripts/db-app-role.ts` lets the role sign in.)
DATABASE_URL=postgresql://clinicmind:clinicmind@localhost:5432/clinicmind?schema=public
# SYSTEM_DATABASE_URL=

# Redis (queues: notifications, whatsapp, voice, ai jobs)
REDIS_URL=redis://localhost:6379

# Auth & embedding secrets — generate with: openssl rand -base64 48
# AUTH_SECRET keys the hashes of session, invitation and password-reset tokens;
# rotating it signs every user out and voids outstanding links.
AUTH_SECRET=replace-me-with-a-long-random-string
EMBED_SIGNING_SECRET=replace-me-with-a-different-long-random-string

# Outbound e-mail for invitation and password-reset links. Leave SMTP_URL unset
# to log messages to the server console instead (fine for local development;
# invitation links are also shown to the inviting administrator).
# Example: smtp://user:password@smtp.example.com:587
SMTP_URL=
MAIL_FROM="ClinicMind <no-reply@example.com>"

# Password given to the two demo accounts by `npm run db:seed` (printed when
# unset and generated randomly; must be at least 12 characters).
SEED_DEMO_PASSWORD=

# Database used by the route tests (`npm test`). When unset, tests use
# DATABASE_URL — point this at a throwaway database. To run them with
# row-level security enforced (as CI does), point it at clinicmind_app and
# TEST_SYSTEM_DATABASE_URL at the owner.
TEST_DATABASE_URL=postgresql://clinicmind:clinicmind@localhost:5432/clinicmind_test?schema=public
# TEST_SYSTEM_DATABASE_URL=

# AI providers (adapter architecture — at least one key required for live AI).
# `auto` picks the first configured provider: chat gemini → openai → anthropic → echo,
# embeddings gemini → openai → echo (Anthropic has no embeddings). Without any key
# the offline `echo` provider is used (deterministic, no clinical reasoning).
AI_DEFAULT_PROVIDER=auto
AI_EMBEDDING_PROVIDER=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model ids (defaults shown). Embeddings are always stored at 1536 dimensions.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Upstream timeout for every provider call, in milliseconds.
AI_TIMEOUT_MS=30000
# After changing the embedding provider/model, rebuild the RAG store:
#   npm run ai:reindex -- <tenant-slug>   (or --all)

# Object storage (S3-compatible) for audio / documents / medical images
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=clinicmind
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Channels
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=


# Background jobs: concierge dispatch, alert rules, overdue follow-ups, reminders.
# The server runs them itself every minute (SCHEDULER=on). Set SCHEDULER=off and
# have an external cron call `POST /api/cron/run` with `Authorization: Bearer $CRON_SECRET`.
SCHEDULER=on
CRON_SECRET=
# Base URL printed in patient-facing links (onboarding forms, concierge check-ins); defaults to APP_URL.
PUBLIC_URL=
