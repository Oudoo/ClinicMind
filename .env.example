# ───────────────────────────── Core ─────────────────────────────
NODE_ENV=production
APP_URL=https://your-domain.com
DATABASE_URL=postgres://growengine:CHANGE_ME@localhost:5432/growengine
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME

# 32-byte hex key for AES-256-GCM credential encryption — generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME

# ───────────────────────────── AI ───────────────────────────────
# At least one provider key is required for AI features; both = automatic failover
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PRIMARY_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
# Embeddings (AOM semantic search) use OpenAI; required for semantic search
EMBEDDING_MODEL=text-embedding-3-small

# Local Whisper (optional, zero marginal transcription cost). When unset,
# the OpenAI Whisper API is used.
WHISPER_CPP_PATH=
WHISPER_CPP_MODEL_PATH=

# ─────────────────────── Object storage ─────────────────────────
# MinIO (self-hosted) or Hostinger Object Storage (S3 compatible)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=growengine

# ───────────────────────────── Email ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="The Grow Engine <no-reply@your-domain.com>"

# ────────────────────────── Monitoring ──────────────────────────
# GlitchTip is Sentry-compatible; paste its DSN here
GLITCHTIP_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─────────────────── Integration OAuth apps ─────────────────────
# Meta Marketing API app
META_APP_ID=
META_APP_SECRET=
# Google OAuth app (GA4 user-OAuth + Google Ads)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GA4 service-account JSON, base64 encoded: base64 -w0 service-account.json
GA4_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=

# ──────────────── Notifications / misc integrations ─────────────
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# ScraperAPI is an OPTIONAL fallback only (crawler is fetch+Cheerio+RSS first)
SCRAPERAPI_KEY=
# Self-hosted Wiki.js knowledge base URL (linked in the sidebar)
WIKIJS_URL=
