# TLS and reverse proxy for ClinicMind.
#
# Certificates are obtained automatically for the app domain, for every active
# tenant's subdomain (<slug>.<ROOT_DOMAIN>) and for every verified custom
# domain. Subdomain and custom-domain certificates are issued on demand, the
# first time a browser connects; the app's /api/tls/ask endpoint decides which
# hostnames are ours, so strangers cannot make this server request certificates
# for arbitrary names. DNS must point both the domain and *.<ROOT_DOMAIN> here.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://web:3000/api/tls/ask
	}
}

(app) {
	encode zstd gzip
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	log {
		output stdout
		format json
	}
}

{$DOMAIN} {
	import app
}

# Tenant subdomains and verified custom domains (gated by /api/tls/ask).
https:// {
	tls {
		on_demand
	}
	import app
}
