# Automatic HTTPS for the app domain. For per-clinic subdomains add a wildcard
# block with a DNS-challenge plugin for your DNS provider, or list each host.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
	log {
		output stdout
		format json
	}
}
