# ClinicMind production environment for docker-compose.prod.yml.
# Copy to the repository root as `.env` on the server and fill in every value.
#
#   cp deploy/env.production.example .env
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
#
# Example values are for the public demo at cm.growcdx.com.

# ── Hostnames ────────────────────────────────────────────────────────────────
# The app domain (landing page, sign-in, platform console). DNS: A record → this server.
DOMAIN=cm.growcdx.com
# Tenants are served as <slug>.ROOT_DOMAIN, e.g. demo.cm.growcdx.com.
# DNS: a wildcard A record *.cm.growcdx.com → this server. Certificates are issued on demand.
ROOT_DOMAIN=cm.growcdx.com
# Receives certificate expiry notices from Let's Encrypt.
ACME_EMAIL=you@example.com

# ── Secrets (generate, never reuse) ──────────────────────────────────────────
#   openssl rand -hex 32      → POSTGRES_PASSWORD, APP_DB_PASSWORD (different values;
#                               hex because they go into connection strings)
#   openssl rand -base64 48   → AUTH_SECRET, EMBED_SIGNING_SECRET (different values)
# POSTGRES_PASSWORD is the database owner's (migrations, backups, cross-clinic work);
# APP_DB_PASSWORD is the app's own role, which row-level security binds.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUTH_SECRET=
EMBED_SIGNING_SECRET=

# ── AI ───────────────────────────────────────────────────────────────────────
# One key is enough for the demo. Gemini has a free tier. Without any key the
# assistant quotes records instead of reasoning and extraction returns empty drafts.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=auto
AI_EMBEDDING_PROVIDER=auto
# Speech-to-text for dictation: auto = Gemini, then OpenAI (needs one of their keys). No silent fallback.
AI_TRANSCRIPTION_PROVIDER=auto
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Encrypts per-tenant provider keys set in the platform console (32+ random characters). Derived from AUTH_SECRET when unset.
# DATA_ENCRYPTION_KEY=

# ── E-mail (invitations, password resets) ────────────────────────────────────
# Optional. Without SMTP_URL links are written to the server log and shown to the inviting administrator.
SMTP_URL=
MAIL_FROM="ClinicMind <no-reply@example.com>"

# ── Demo clinic ──────────────────────────────────────────────────────────────
# Password of the six demo accounts created by the seed (12+ characters).
SEED_DEMO_PASSWORD=

# ── Operations ───────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
# After each nightly dump, restore it into a scratch database and check it (scripts/restore-drill.sh); "off" skips it.
RESTORE_DRILL=on
LOG_LEVEL=info
# Prebuilt images from GitHub Actions (optional; the server builds locally when it cannot pull them).
# CLINICMIND_IMAGE=ghcr.io/oudoo/clinicmind:latest
# CLINICMIND_TOOLS_IMAGE=ghcr.io/oudoo/clinicmind-tools:latest
