// ─────────────────────────────────────────────────────────────────────────────
// ClinicMind — Prisma schema
//
// AI-first, multi-tenant Medical OS. Every domain row is scoped to a Tenant so
// that each client gets a fully isolated instance of the tool. The schema is
// built for: row-level isolation, soft delete, immutable audit, full-text search
// and pgvector RAG embeddings.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector, pg_trgm]
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  CLINIC_OWNER
  DOCTOR
  RECEPTIONIST
  NURSE
  ASSISTANT
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuthTokenKind {
  INVITE
  PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  WAITLISTED
}

enum ChannelType {
  WHATSAPP
  VOICE
  SMS
  WEB_CHAT
  IN_PERSON
}

enum ConversationDirection {
  INBOUND
  OUTBOUND
}

enum ConsultationStatus {
  RECORDING
  TRANSCRIBING
  EXTRACTING
  PENDING_REVIEW
  SIGNED
  DISCARDED
}

enum AiRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum TimelineKind {
  APPOINTMENT
  CALL
  WHATSAPP_MESSAGE
  DIAGNOSIS
  PRESCRIPTION
  AUDIO
  DOCUMENT
  AI_NOTE
  VISIT
  PROCEDURE
  PAYMENT
  CHECK_IN
  ESCALATION
  INTAKE
  LEAD
}

enum EmbeddingSource {
  TRANSCRIPT
  VISIT_NOTE
  DIAGNOSIS
  MEDICATION
  CONVERSATION
}

// ── Tenancy & branding ───────────────────────────────────────────────────────

/// A Tenant is one client's fully isolated ClinicMind instance. Resolved at
/// request time by custom domain or subdomain (see lib/tenant.ts).
model Tenant {
  id     String       @id @default(cuid())
  slug   String       @unique // subdomain, e.g. "acme" -> acme.clinics.host
  name   String
  status TenantStatus @default(PROVISIONING)

  // White-label / custom-domain integration so each client can run it on their
  // own website. customDomain is verified before traffic is served.
  customDomain         String? @unique
  customDomainVerified Boolean @default(false)

  branding Json? // { accent, logoUrl, productName, ... } overrides brand.ts defaults
  settings Json? // tenant feature flags & locale (ar / en / arz)
  embed    TenantEmbedConfig?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clinics          Clinic[]
  users            User[]
  patients         Patient[]
  medicalHistories MedicalHistory[]
  medications      Medication[]
  appointments     Appointment[]
  visits           Visit[]
  conversations    Conversation[]
  messages         Message[]
  consultations    Consultation[]
  aiRuns           AiRun[]
  embeddings       KnowledgeEmbedding[]
  timeline         TimelineEvent[]
  documents        Document[]
  auditLogs        AuditLog[]

  treatments              Treatment[]
  campaigns               Campaign[]
  campaignCosts           CampaignCost[]
  leads                   Lead[]
  leadFollowUps           LeadFollowUp[]
  messageTemplates        MessageTemplate[]
  channelIntegrations     ChannelIntegration[]
  procedures              Procedure[]
  payments                Payment[]
  protocols               Protocol[]
  enrolments              ConciergeEnrolment[]
  conciergeTasks          ConciergeTask[]
  checkIns                CheckIn[]
  escalations             Escalation[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  alertRules              AlertRule[]
  metricTargets           MetricTarget[]
  intakeLinks             IntakeLink[]
  intakeSubmissions       IntakeSubmission[]
  appointmentNotes        AppointmentNote[]
  savedViews              SavedView[]
  reviewSnapshots         ReviewSnapshot[]
  fileBlobs               FileBlob[]
  safetyOverrides         SafetyOverride[]
  priceItems              PriceItem[]
  priceItemPrices         PriceItemPrice[]
  charges                 Charge[]
  invoices                Invoice[]
  invoiceLines            InvoiceLine[]
  creditNotes             CreditNote[]
  paymentAllocations      PaymentAllocation[]
  writeOffs               WriteOff[]
  documentSequences       DocumentSequence[]

  @@index([status])
  @@map("tenants")
}

/// Configuration governing how a tenant may embed ClinicMind into their own site
/// or into another portal of theirs.
model TenantEmbedConfig {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Exact origins (scheme + host [+ port]) allowed to frame the /embed surface
  // and to mint embed tokens. An empty list refuses every token request.
  allowedOrigins String[] @default([])

  // The embed *secret* is the credential a client's backend presents to
  // POST /api/embed/token. It is generated with a CSPRNG, stored only as a
  // SHA-256 hash, and shown to the tenant exactly once at (re)generation.
  // `secretPrefix` keeps the first, non-secret characters so the UI can show
  // which secret is live without ever rendering the secret itself.
  secretHash      String?   @unique
  secretPrefix    String?
  secretRotatedAt DateTime?

  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_embed_configs")
}

model Clinic {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// Short branch code printed in its document numbers ("ZAM-INV-000042"); from the name when not set.
  code      String?
  address   String?
  phone     String?
  timezone  String    @default("Africa/Cairo")
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users        User[]
  appointments Appointment[]
  prices       PriceItemPrice[]
  invoices     Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("clinics")
}

// ── Identity, RBAC & sessions ────────────────────────────────────────────────

/// A staff member of one tenant. `passwordHash` is an argon2id hash
/// (lib/auth/password.ts) and stays null until the user accepts their
/// invitation; only ACTIVE users with a password can sign in.
model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId     String?
  clinic       Clinic?    @relation(fields: [clinicId], references: [id])
  role         UserRole
  email        String
  fullName     String?
  passwordHash String?
  status       UserStatus @default(INVITED)

  /// May sign clinical notes and procedures and approve protocols (together with
  /// the role's consultations:sign permission). Set per person by the clinic
  /// owner, so an owner-level administrator who is not a clinician cannot sign.
  isClinician Boolean @default(false)

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions               Session[]
  loginHistory           LoginEvent[]
  authTokens             AuthToken[]
  doctorVisits           Visit[]                 @relation("DoctorVisits")
  authoredAiRuns         AiRun[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  savedViews             SavedView[]
  safetyOverrides        SafetyOverride[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

/// Server-side login session. The browser holds a random token in an httpOnly
/// cookie; only its keyed hash is stored here (lib/auth/session.ts).
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  device     String?
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

/// One row per password sign-in attempt against a known user, successful or
/// not. Recent failures drive the per-account lockout in lib/auth/login.ts.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean
  ip        String?
  device    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_events")
}

/// Single-use, expiring tokens for accepting an invitation or resetting a
/// password. As with sessions only the keyed hash is stored; the raw token
/// travels once, inside the emailed link (lib/auth/auth-tokens.ts).
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
  @@map("auth_tokens")
}

// ── Patients & clinical records ──────────────────────────────────────────────

model Patient {
  id                String      @id @default(cuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName          String
  gender            Gender      @default(UNDISCLOSED)
  dateOfBirth       DateTime?
  phone             String?
  whatsapp          String?
  email             String?
  emergencyContact  String?
  address           String?
  /// Preferred language for communication: "ar" | "en".
  language          String      @default("ar")
  tags              String[]    @default([])
  notes             String?
  /// National ID or passport number, for the front desk's exact lookup.
  nationalId        String?
  city              String?
  /// First-touch source when the patient came through the CRM.
  source            LeadSource?
  referredBy        String?
  /// The family member who pays for this patient: their payments go towards this patient's invoices too.
  /// One level only (a head has no head of their own and a member heads no one; a trigger enforces it).
  householdHeadId   String?
  householdHead     Patient?    @relation("Household", fields: [householdHeadId], references: [id], onDelete: SetNull)
  /// How the patient is related to the head: SPOUSE, CHILD, PARENT, SIBLING or OTHER.
  householdRelation String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  medicalHistory   MedicalHistory?
  medications      Medication[]
  appointments     Appointment[]
  visits           Visit[]
  conversations    Conversation[]
  consultations    Consultation[]
  documents        Document[]
  timeline         TimelineEvent[]
  leads            Lead[]
  procedures       Procedure[]
  payments         Payment[]
  charges          Charge[]
  invoices         Invoice[]
  enrolments       ConciergeEnrolment[]
  checkIns         CheckIn[]
  appointmentNotes AppointmentNote[]
  intakeLinks      IntakeLink[]
  householdMembers Patient[]            @relation("Household")
  writeOffs        WriteOff[]

  @@index([tenantId])
  @@index([tenantId, householdHeadId])
  @@index([tenantId, nationalId])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@map("patients")
}

model MedicalHistory {
  id                String   @id @default(cuid())
  // Denormalized from the patient so the row is tenant-scoped on its own.
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId         String   @unique
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diagnoses         Json     @default("[]")
  symptoms          Json     @default("[]")
  allergies         Json     @default("[]")
  surgeries         Json     @default("[]")
  chronicConditions Json     @default("[]")
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@map("medical_histories")
}

model Medication {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name       String
  dosage     String?
  frequency  String?
  startDate  DateTime?
  endDate    DateTime?
  active     Boolean   @default(true)
  /// Set when a clinician stops the medication (reconciliation on sign).
  stoppedAt  DateTime?
  stopReason String?
  /// Visit in which the medication was prescribed, when known.
  visitId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([patientId, active])
  @@index([tenantId])
  @@map("medications")
}

// ── Appointments ─────────────────────────────────────────────────────────────

model Appointment {
  id                      String            @id @default(cuid())
  tenantId                String
  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId                String?
  clinic                  Clinic?           @relation(fields: [clinicId], references: [id])
  patientId               String
  patient                 Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId                String?
  room                    String?
  startsAt                DateTime
  endsAt                  DateTime
  status                  AppointmentStatus @default(SCHEDULED)
  reason                  String?
  notes                   String?
  source                  ChannelType       @default(IN_PERSON)
  /// Why the appointment was cancelled or marked a no-show.
  cancelReason            String?
  statusChangedAt         DateTime?
  createdById             String?
  kind                    AppointmentKind   @default(CONSULTATION)
  treatmentId             String?
  /// The CRM lead this booking came from, when it did.
  leadId                  String?
  confirmedAt             DateTime?
  /// When the patient was last asked to confirm a moved time (WhatsApp, reply 1 or 2); cleared once they answer or the booking changes status.
  confirmationRequestedAt DateTime?
  checkedInAt             DateTime?
  reminderSentAt          DateTime?
  /// Set once when reception was told the patient has not checked in (appointments-late-flag job).
  lateFlaggedAt           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  visit         Visit?
  dictatedNotes AppointmentNote[]

  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([tenantId, patientId, startsAt])
  @@index([doctorId, startsAt])
  @@index([tenantId, kind])
  @@map("appointments")
}

// ── Visits / consultations & AI ──────────────────────────────────────────────

model Visit {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        User?        @relation("DoctorVisits", fields: [doctorId], references: [id])

  notes      String?
  transcript String?
  summary    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultation Consultation?

  @@index([tenantId, patientId])
  @@map("visits")
}

/// A live consultation capture: audio -> transcript -> structured extraction.
/// Clinical decisions are NEVER auto-saved; a doctor must review & sign.
model Consultation {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId   String?            @unique
  visit     Visit?             @relation(fields: [visitId], references: [id])
  doctorId  String?
  status    ConsultationStatus @default(RECORDING)

  audioKey     String? // S3 object key
  transcript   String?
  // Structured extraction stored separately from free text.
  extraction   Json? // { symptoms[], diagnoses[], medications[], tests[], followUps[] }
  summary      String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("consultations")
}

/// Every AI invocation is recorded immutably — prompt, retrieved context, output
/// and confidence. History is append-only; rows are never overwritten.
model AiRun {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?       @relation(fields: [authorId], references: [id])
  kind             String // "assistant_chat" | "summary" | "extraction" | "briefing"
  provider         String
  model            String
  rawPrompt        String
  retrievedContext Json?
  generatedOutput  String?
  citations        Json?
  confidenceScore  Float?
  status           AiRunStatus @default(PENDING)
  latencyMs        Int?
  error            String?
  createdAt        DateTime    @default(now())

  @@index([tenantId, kind, createdAt])
  @@map("ai_runs")
}

// ── Conversations (AI receptionist & voice agent) ────────────────────────────

model Conversation {
  id                    String             @id @default(cuid())
  tenantId              String
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId             String?
  patient               Patient?           @relation(fields: [patientId], references: [id])
  channel               ChannelType
  externalId            String? // WhatsApp wa_id / call sid
  locale                String             @default("ar")
  recordingKey          String?
  transcript            String?
  summary               String?
  leadId                String?
  lead                  Lead?              @relation(fields: [leadId], references: [id])
  status                ConversationStatus @default(OPEN)
  assignedToId          String?
  /// Objection tags set by the AI while the thread runs; confirmed by staff when the lead closes.
  objections            ObjectionTag[]     @default([])
  objectionsConfirmedAt DateTime?
  contactName           String?
  contactPhone          String?
  lastInboundAt         DateTime?
  lastOutboundAt        DateTime?
  closedAt              DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  messages Message[]

  @@index([tenantId, channel, createdAt])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, leadId])
  @@map("conversations")
}

model Message {
  id             String                @id @default(cuid())
  // Must always equal conversation.tenantId; denormalized for RLS and checks.
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      ConversationDirection
  body           String
  meta           Json?
  author         MessageAuthor         @default(HUMAN)
  authorId       String?
  delivery       MessageDelivery       @default(LOGGED)
  externalId     String?
  templateKey    String?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedReason   String?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@map("messages")
}

// ── Documents & unified timeline ─────────────────────────────────────────────

model Document {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  kind      String // pdf | image | lab | attachment
  s3Key     String
  mimeType  String?
  sizeBytes Int?
  scanned   Boolean  @default(false) // malware scan completed
  safe      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([tenantId])
  @@map("documents")
}

/// Denormalized chronological feed powering the unified patient timeline.
model TimelineEvent {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind       TimelineKind
  title      String
  body       String?
  refId      String? // id of the source record
  occurredAt DateTime
  createdAt  DateTime     @default(now())

  @@index([tenantId, patientId, occurredAt])
  @@map("timeline_events")
}

// ── RAG embeddings (pgvector) ────────────────────────────────────────────────

model KnowledgeEmbedding {
  id          String                       @id @default(cuid())
  tenantId    String
  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      EmbeddingSource
  /// Id of the source record (patient, visit, consultation, conversation…).
  refId       String
  /// Patient the chunk is about, when applicable — lets answers cite a patient.
  patientId   String?
  /// Position of this chunk within the source document (0-based).
  chunkIndex  Int                          @default(0)
  content     String
  /// SHA-256 of `content`; unchanged chunks are not re-embedded on re-index.
  contentHash String?
  /// Free-form provenance (title, occurredAt, model used, …).
  metadata    Json?
  // 1536-dim vector (OpenAI text-embedding-3-small, or Gemini with
  // outputDimensionality 1536). Indexed with ivfflat in the migration SQL.
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@unique([tenantId, source, refId, chunkIndex])
  @@index([tenantId, source])
  @@index([tenantId, patientId])
  @@map("knowledge_embeddings")
}

// ── Immutable audit log ──────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  /// The patient whose record the action concerns, when there is one; written
  /// by lib/audit.ts so the owner can search the log by patient. No foreign
  /// key: the log outlives the rows it describes.
  patientId  String?
  ip         String?
  device     String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@map("audit_logs")
}

// ── PM round 2: CRM, finance, concierge, notifications, intake ───────────────

enum AppointmentKind {
  CONSULTATION
  FOLLOW_UP
  PROCEDURE
  CHECK_UP
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  CONSULTATION_BOOKED
  CONSULTATION_ATTENDED
  PROCEDURE_BOOKED
  WON
  LOST
}

enum LeadSource {
  CLICK_TO_WHATSAPP_AD
  INSTAGRAM_ORGANIC
  WEBSITE
  REFERRAL
  WALK_IN
  PHONE
  OTHER
}

enum LostReason {
  NO_RESPONSE
  PRICE
  DISTANCE
  CHOSE_COMPETITOR
  NOT_A_FIT
  TIMING
  OTHER
}

enum ObjectionTag {
  PRICE
  PAIN
  DOWNTIME
  RESULTS_DOUBT
  TRUST
  TIMING
}

enum CampaignPlatform {
  META
  GOOGLE
  TIKTOK
  OTHER
}

enum ConversationStatus {
  OPEN
  WAITING_ON_CLINIC
  WAITING_ON_PATIENT
  CLOSED
}

enum MessageAuthor {
  PATIENT
  AI
  HUMAN
  SYSTEM
}

enum MessageDelivery {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  /// Written to the record (and the server log) because no channel is connected.
  LOGGED
}

/// PLANNED → (STARTED, for work done in stages) → SIGNED (done, charged), or CANCELLED.
enum ProcedureStatus {
  PLANNED
  STARTED
  SIGNED
  CANCELLED
}

enum PaymentKind {
  DEPOSIT
  PAYMENT
  REFUND
  CONSULTATION_FEE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  WALLET
  POS
  INSTAPAY
  CHEQUE
  OTHER
}

/// DRAFT (no number yet) → ISSUED (numbered) → PART_PAID → PAID as payments are allocated; CANCELLED only with a reason and a credit note.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  CANCELLED
}

enum ProtocolStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ProtocolStepKind {
  INSTRUCTION
  CHECK_IN
  PHOTO_REQUEST
}

enum EnrolmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
}

enum ConciergeTaskStatus {
  PENDING
  SENT
  ANSWERED
  MISSED
  SKIPPED
}

enum TriageLevel {
  OK
  WATCH
  HIGH_RISK
}

enum EscalationKind {
  CONCIERGE
  LEAD_FOLLOW_UP
  MANUAL
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum NotificationKind {
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_CONFLICT
  NO_SHOW
  REVIEW_PENDING
  ESCALATION
  FOLLOW_UP_OVERDUE
  INTAKE_SUBMITTED
  LEAD_NEW
  MESSAGE_INBOUND
  CHECK_IN_ANSWERED
  PAYMENT_RECORDED
  ALERT_RULE
  WEEKLY_BRIEF
  SAFETY_OVERRIDE
  SYSTEM
}

enum NotificationLevel {
  INFO
  WARNING
  CRITICAL
}

enum AlertMetric {
  NO_SHOW_RATE
  FIRST_RESPONSE_P50
  FIRST_RESPONSE_P90
  FOLLOW_UPS_OVERDUE
  ESCALATIONS_UNACKNOWLEDGED
  CHECK_IN_ANSWER_RATE
  CAMPAIGN_WITHOUT_PROCEDURE
  REVIEWS_PENDING
  LOST_LEADS_PRICE_SHARE
  LEAD_TO_CONSULTATION
  REVENUE
}

enum AlertComparator {
  ABOVE
  BELOW
}

enum IntakeLinkKind {
  OPEN
  PATIENT
}

enum IntakeStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AppointmentNoteKind {
  DICTATION
  TEXT
}

enum ReviewSource {
  GOOGLE_BUSINESS_PROFILE
  MANUAL
}

/// The clinic's treatment catalogue: what leads ask about, what procedures are
/// signed as, what a protocol belongs to. Money is whole EGP everywhere.
model Treatment {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key             String // "hair-transplant"
  name            String
  category        String? // hair | skin | laser | injectables | general
  consultationFee Int?
  priceFrom       Int?
  priceTo         Int?
  depositAmount   Int?
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  procedures Procedure[]
  protocols  Protocol[]
  campaigns  Campaign[]
  priceItems PriceItem[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("treatments")
}

/// An ads campaign as the platform names it; costs are entered or imported per period.
model Campaign {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  platform    CampaignPlatform
  source      LeadSource       @default(CLICK_TO_WHATSAPP_AD)
  treatmentId String?
  treatment   Treatment?       @relation(fields: [treatmentId], references: [id])
  active      Boolean          @default(true)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  leads Lead[]
  costs CampaignCost[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@map("campaigns")
}

model CampaignCost {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  amount      Int
  currency    String   @default("EGP")
  source      String   @default("manual") // manual | csv | meta | google
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, campaignId, periodStart])
  @@map("campaign_costs")
}

/// A CRM lead: an enquiry that may become a patient. Interests hold treatment
/// keys; a lead with two interests counts once per interest in the reports.
model Lead {
  id                        String         @id @default(cuid())
  tenantId                  String
  tenant                    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId                 String?
  patient                   Patient?       @relation(fields: [patientId], references: [id])
  fullName                  String
  phone                     String?
  whatsapp                  String?
  email                     String?
  source                    LeadSource     @default(OTHER)
  campaignId                String?
  campaign                  Campaign?      @relation(fields: [campaignId], references: [id])
  interests                 String[]       @default([])
  stage                     LeadStage      @default(NEW)
  ownerId                   String?
  lostReason                LostReason?
  lostAtStage               LeadStage?
  lostAt                    DateTime?
  lostNote                  String?
  /// Objections confirmed by staff when the lead is closed.
  objections                ObjectionTag[] @default([])
  consultationAppointmentId String?
  notes                     String?
  firstTouchAt              DateTime       @default(now())
  lastContactAt             DateTime?
  wonAt                     DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  deletedAt                 DateTime?

  followUps     LeadFollowUp[]
  conversations Conversation[]
  escalations   Escalation[]

  @@index([tenantId, stage])
  @@index([tenantId, createdAt])
  @@index([tenantId, phone])
  @@index([tenantId, campaignId])
  @@index([tenantId, ownerId])
  @@map("leads")
}

model LeadFollowUp {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId     String?
  dueAt       DateTime
  note        String?
  channel     ChannelType?
  doneAt      DateTime?
  doneById    String?
  outcome     String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId, dueAt])
  @@index([tenantId, ownerId, doneAt])
  @@index([leadId])
  @@map("lead_follow_ups")
}

/// Reply templates for the reception inbox, with {{placeholders}}.
model MessageTemplate {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  name      String
  language  String       @default("ar")
  body      String
  channel   ChannelType?
  category  String? // booking | follow-up | intake | concierge | price
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, key])
  @@map("message_templates")
}

/// How a channel is connected for this tenant (WhatsApp Cloud API, an inbox
/// webhook, or manual). Secrets are stored hashed; config holds no secret.
model ChannelIntegration {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel        ChannelType
  provider       String // whatsapp_cloud | inbox_webhook | manual
  config         Json?
  secretHash     String?
  secretPrefix   String?
  enabled        Boolean     @default(false)
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([tenantId, channel])
  @@map("channel_integrations")
}

/// A treatment performed (or planned) for a patient. Signing it is what enrols
/// the patient in the concierge protocol and what the revenue reports count.
model Procedure {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatmentId      String
  treatment        Treatment       @relation(fields: [treatmentId], references: [id])
  /// The price-list item billed, and how many of its unit (sessions, areas, grafts…); `price` is what that came to on the day.
  priceItemId      String?
  priceItem        PriceItem?      @relation(fields: [priceItemId], references: [id])
  quantity         Int             @default(1)
  doctorId         String?
  appointmentId    String?
  visitId          String?
  consultationId   String?
  performedAt      DateTime
  price            Int
  discount         Int             @default(0)
  /// Why a discount was given (a key of the fixed list, see finance/constants.ts); required with a discount.
  discountReason   String?
  /// The words for a discount given for "another reason".
  discountNote     String?
  /// Who gave the discount (within their role's limit; above it, only the owner).
  discountById     String?
  currency         String          @default("EGP")
  status           ProcedureStatus @default(PLANNED)
  /// Work done in stages (the sessions of a course): how many. Each stage's share is charged when it is done.
  stages           Int             @default(1)
  /// The day staged work started (required to start it).
  startedAt        DateTime?
  startedById      String?
  /// Why it is charged nothing; required when price − discount is 0.
  zeroChargeReason String?
  signedAt         DateTime?
  signedById       String?
  cancelledAt      DateTime?
  cancelReason     String?
  notes            String?
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  payments  Payment[]
  charges   Charge[]
  enrolment ConciergeEnrolment?

  @@index([tenantId, performedAt])
  @@index([tenantId, patientId])
  @@index([tenantId, doctorId])
  @@index([tenantId, treatmentId])
  @@index([tenantId, status])
  @@map("procedures")
}

/// What a patient owes for work done, posted when the work is done: a procedure when it is signed, each
/// stage of staged work as it is done, or a visit charged nothing (with the reason). Never edited (a
/// trigger refuses it) and never deleted by the app: a correction is a reversing row.
model Charge {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// NoAction: checked at the end of the statement, so removing a whole tenant (which cascades to both) works.
  procedureId   String?
  procedure     Procedure? @relation(fields: [procedureId], references: [id], onDelete: NoAction)
  appointmentId String?
  /// The stage of staged work (1-based); null: the whole procedure, what remained of it, or a visit.
  stage         Int?
  /// Whole EGP; negative on a reversal.
  amount        Int
  description   String
  /// When the work was done.
  chargedAt     DateTime
  doctorId      String?
  /// The branch the work was done at.
  clinicId      String?
  reversalOfId  String?    @unique
  reversalOf    Charge?    @relation("ChargeReversal", fields: [reversalOfId], references: [id], onDelete: NoAction)
  reversedBy    Charge?    @relation("ChargeReversal")
  /// A discount taken off a charge already posted (a negative row): the charge it takes off, and why.
  discountOfId  String?
  discountOf    Charge?    @relation("ChargeDiscount", fields: [discountOfId], references: [id], onDelete: NoAction)
  discounts     Charge[]   @relation("ChargeDiscount")
  /// A discount's reason (a key of the fixed list).
  reason        String?
  createdById   String?
  createdAt     DateTime   @default(now())

  invoiceLines InvoiceLine[]

  @@index([tenantId, chargedAt])
  @@index([tenantId, patientId])
  @@index([tenantId, appointmentId])
  @@index([procedureId])
  @@index([discountOfId])
  @@map("charges")
}

/// A branch's running number for one kind of document (INVOICE, CREDIT_NOTE, RECEIPT, REFUND). Taken inside
/// the transaction that issues the document, so a number is spent only when the document exists: no gaps.
model DocumentSequence {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId String
  kind     String
  next     Int    @default(1)

  @@id([tenantId, clinicId, kind])
  @@map("document_sequences")
}

/// What a patient is billed: charges of one branch on numbered lines. A draft has no number and can be
/// discarded; issuing gives it the branch's next number, and from then on it is never deleted, only
/// cancelled with a reason and a credit note.
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: NoAction)
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status         InvoiceStatus @default(DRAFT)
  /// Set when issued: the branch's running number and how it prints.
  sequence       Int?
  number         String?
  /// "ar" | "en": the language it is printed and sent in.
  language       String        @default("en")
  total          Int           @default(0)
  note           String?
  issuedAt       DateTime?
  issuedById     String?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  /// The patient's copy online, behind a token (stored hashed) that the WhatsApp message links to.
  shareTokenHash String?       @unique
  sentAt         DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines       InvoiceLine[]
  creditNote  CreditNote?
  allocations PaymentAllocation[]
  writeOffs   WriteOff[]

  @@unique([tenantId, clinicId, sequence])
  @@unique([tenantId, number])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("invoices")
}

/// One charge on an invoice, as it read when invoiced.
model InvoiceLine {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// NoAction: checked at the end of the statement, so removing a whole tenant works.
  chargeId    String
  charge      Charge   @relation(fields: [chargeId], references: [id], onDelete: NoAction)
  description String
  amount      Int
  chargedAt   DateTime
  position    Int

  @@index([tenantId, invoiceId])
  @@index([chargeId])
  @@map("invoice_lines")
}

/// The credit note that cancels an issued invoice, numbered in its branch's own sequence.
model CreditNote {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId   String
  invoiceId  String   @unique
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sequence   Int
  number     String
  amount     Int
  reason     String
  issuedAt   DateTime
  issuedById String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, clinicId, sequence])
  @@unique([tenantId, number])
  @@map("credit_notes")
}

/// Money a payment puts towards an invoice. What a patient paid and is not allocated is their credit.
model PaymentAllocation {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Int
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, invoiceId])
  @@index([paymentId])
  @@map("payment_allocations")
}

/// What is left on an issued invoice that the clinic gives up on (a bad debt, a balance too small to chase…): the
/// owner's decision, with a reason from a fixed list. It settles the invoice without money and comes off what the
/// patient owes; it is never edited, and is voided only with the invoice it was on (cancelled by a credit note).
model WriteOff {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Whole EGP, up to what was left to pay on the invoice.
  amount       Int
  /// A key of the fixed list (see finance/constants.ts).
  reason       String
  note         String?
  writtenOffAt DateTime
  createdById  String?
  voidedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, writtenOffAt])
  @@index([tenantId, patientId])
  @@index([invoiceId])
  @@map("write_offs")
}

/// Money in or out, whole EGP: deposits, payments, refunds and consultation fees.
model Payment {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedureId     String?
  procedure       Procedure?    @relation(fields: [procedureId], references: [id])
  appointmentId   String?
  leadId          String?
  kind            PaymentKind
  method          PaymentMethod @default(CASH)
  amount          Int
  currency        String        @default("EGP")
  paidAt          DateTime
  reference       String?
  note            String?
  importBatchId   String?
  /// The branch that took it, and its receipt (money in) or refund voucher (money out) number there, gapless.
  clinicId        String?
  receiptSequence Int?
  receiptNumber   String?
  createdById     String?
  createdAt       DateTime      @default(now())
  deletedAt       DateTime?

  allocations PaymentAllocation[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, paidAt])
  @@index([tenantId, patientId])
  @@index([tenantId, appointmentId])
  @@index([procedureId])
  @@map("payments")
}

/// A versioned post-treatment protocol: instructions, structured check-ins and
/// photo requests at offsets from the procedure. Steps are JSON (see
/// modules/concierge/protocols.ts for the shape).
model Protocol {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treatmentId  String
  treatment    Treatment      @relation(fields: [treatmentId], references: [id])
  name         String
  version      Int            @default(1)
  status       ProtocolStatus @default(DRAFT)
  steps        Json           @default("[]")
  notes        String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  retiredAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  enrolments ConciergeEnrolment[]

  @@unique([tenantId, treatmentId, version])
  @@index([tenantId, status])
  @@map("protocols")
}

model ConciergeEnrolment {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedureId String          @unique
  procedure   Procedure       @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  protocolId  String
  protocol    Protocol        @relation(fields: [protocolId], references: [id])
  status      EnrolmentStatus @default(ACTIVE)
  channel     ChannelType     @default(WHATSAPP)
  language    String          @default("ar")
  startedAt   DateTime
  completedAt DateTime?
  pausedAt    DateTime?
  pauseReason String?
  stoppedAt   DateTime?
  stopReason  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tasks       ConciergeTask[]
  checkIns    CheckIn[]
  escalations Escalation[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("concierge_enrolments")
}

/// One scheduled step of an enrolment. A check-in carries a hashed token for
/// the patient's public link.
model ConciergeTask {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrolmentId String
  enrolment   ConciergeEnrolment  @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  stepIndex   Int
  kind        ProtocolStepKind
  title       String
  dueAt       DateTime
  sentAt      DateTime?
  status      ConciergeTaskStatus @default(PENDING)
  tokenHash   String?             @unique
  messageId   String?
  answeredAt  DateTime?
  missedAt    DateTime?
  attempts    Int                 @default(0)
  lastError   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  checkIn CheckIn?

  @@index([tenantId, status, dueAt])
  @@index([enrolmentId, stepIndex])
  @@map("concierge_tasks")
}

/// A patient's answers to a check-in, with the triage the protocol produced.
model CheckIn {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrolmentId  String
  enrolment    ConciergeEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  taskId       String             @unique
  task         ConciergeTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  answers      Json
  satisfaction Int?
  freeText     String?
  photoIds     String[]           @default([])
  triage       TriageLevel        @default(OK)
  flags        Json               @default("[]")
  source       String             @default("link") // link | staff | whatsapp
  submittedAt  DateTime           @default(now())

  escalations Escalation[]

  @@index([tenantId, submittedAt])
  @@index([tenantId, patientId])
  @@map("check_ins")
}

/// Something a named human must look at within a target time: a high-risk or
/// out-of-range check-in, an overdue lead, a manual flag.
model Escalation {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind             EscalationKind
  level            TriageLevel         @default(WATCH)
  status           EscalationStatus    @default(OPEN)
  enrolmentId      String?
  enrolment        ConciergeEnrolment? @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  checkInId        String?
  checkIn          CheckIn?            @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  leadId           String?
  lead             Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  patientId        String?
  summary          String
  details          Json?
  assignedToId     String?
  outOfHours       Boolean             @default(false)
  dueAt            DateTime
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolution       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assignedToId, status])
  @@map("escalations")
}

/// In-app notification for one user; e-mail copies follow the preference.
model Notification {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  level     NotificationLevel @default(INFO)
  title     String
  body      String?
  href      String?
  entity    String?
  entityId  String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime          @default(now())

  @@index([tenantId, userId, readAt, createdAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// { [NotificationKind]: boolean }; a missing kind is on.
  inApp      Json     @default("{}")
  /// { [NotificationKind]: boolean }; a missing kind is off except ESCALATION and ALERT_RULE.
  email      Json     @default("{}")
  browser    Boolean  @default(false)
  digestHour Int?
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@map("notification_preferences")
}

/// A threshold on a reported metric, evaluated on a schedule; firing notifies the roles named.
model AlertRule {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  metric          AlertMetric
  comparator      AlertComparator
  threshold       Float
  windowDays      Int             @default(7)
  enabled         Boolean         @default(true)
  notifyRoles     UserRole[]      @default([CLINIC_OWNER])
  lastEvaluatedAt DateTime?
  lastFiredAt     DateTime?
  lastValue       Float?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId, enabled])
  @@map("alert_rules")
}

/// Baseline and target per reported metric (the spec's success-metrics table).
model MetricTarget {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric      String
  baseline    Float?
  target      Float?
  unit        String?
  dueAt       DateTime?
  updatedById String?
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, metric])
  @@map("metric_targets")
}

/// A shareable onboarding link: open (anyone with the link) or for one patient.
model IntakeLink {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind          IntakeLinkKind @default(OPEN)
  tokenHash     String         @unique
  tokenPrefix   String
  patientId     String?
  patient       Patient?       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  language      String         @default("ar")
  label         String?
  expiresAt     DateTime
  maxUses       Int?
  uses          Int            @default(0)
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())

  submissions IntakeSubmission[]

  @@index([tenantId, createdAt])
  @@index([tenantId, patientId])
  @@map("intake_links")
}

/// What a patient submitted through an onboarding link, until reception accepts it.
model IntakeSubmission {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkId           String
  link             IntakeLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  status           IntakeStatus @default(PENDING)
  fullName         String
  phone            String?
  email            String?
  data             Json
  matchedPatientId String?
  patientId        String?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  ip               String?
  submittedAt      DateTime     @default(now())

  @@index([tenantId, status, submittedAt])
  @@map("intake_submissions")
}

/// A note dictated (or typed) onto an appointment; carried into the consultation.
model AppointmentNote {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId   String
  appointment     Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind            AppointmentNoteKind @default(DICTATION)
  body            String
  language        String?
  durationSeconds Int?
  authorId        String?
  createdAt       DateTime            @default(now())
  deletedAt       DateTime?
  deletedById     String?

  @@index([tenantId, appointmentId])
  @@index([tenantId, patientId])
  @@map("appointment_notes")
}

/// A user's saved filter set for a list (patients today).
model SavedView {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  name      String
  params    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, scope])
  @@map("saved_views")
}

/// Weekly public review count and rating (Google Business Profile, or entered by hand).
model ReviewSnapshot {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      ReviewSource @default(MANUAL)
  weekStart   DateTime     @db.Date
  count       Int
  rating      Float
  createdById String?
  createdAt   DateTime     @default(now())

  @@unique([tenantId, source, weekStart])
  @@map("review_snapshots")
}

/// Small uploads (check-in photos, intake attachments) kept in the database
/// when no object storage is configured. Documents point at "blob:<id>".
model FileBlob {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String?
  mimeType  String
  sizeBytes Int
  bytes     Bytes
  createdAt DateTime @default(now())

  @@index([tenantId, patientId])
  @@map("file_blobs")
}

/// A prescribing-safety warning or stop that a clinician chose to override,
/// with their reason. Written when the consultation is signed and listed for
/// the owner's review. Nothing updates or deletes these rows.
model SafetyOverride {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consultationId String?
  patientId      String
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  /// Stable rule id, e.g. "allergy.cross-reactivity", "pregnancy.contraindicated".
  rule           String
  /// "stop" (needed a typed reason) or "warn" (acknowledged).
  severity       String
  medication     String?
  message        String
  detail         Json?
  reason         String
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, patientId])
  @@index([tenantId, userId, createdAt])
  @@map("safety_overrides")
}

// ── Phase 2: finance ─────────────────────────────────────────────────────────

/// How a price-list item is counted: per visit, session, area treated, unit (grafts, syringes: `unitLabel`), tooth or arch, or a course package.
enum PriceUnit {
  VISIT
  SESSION
  AREA
  UNIT
  TOOTH
  ARCH
  PACKAGE
}

/// The clinic's price list: one row per billable item. The code is fixed once created (it is printed on invoices).
model PriceItem {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  name          String
  /// hair | skin | laser | injectables | general (the treatment categories)
  category      String
  unit          PriceUnit   @default(SESSION)
  /// What one unit is called when the unit is UNIT ("graft", "syringe").
  unitLabel     String?
  /// The treatment it bills for: procedures, concierge protocols and the reports group by it.
  treatmentId   String
  /// NoAction: checked at the end of the statement, so removing a whole tenant (which cascades to both) works.
  treatment     Treatment   @relation(fields: [treatmentId], references: [id], onDelete: NoAction)
  /// A course package: this many sessions of `sessionItem`, sold together at the package price.
  sessions      Int?
  sessionItemId String?
  sessionItem   PriceItem?  @relation("PackageSessions", fields: [sessionItemId], references: [id])
  packages      PriceItem[] @relation("PackageSessions")
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  prices     PriceItemPrice[]
  procedures Procedure[]

  @@unique([tenantId, code])
  @@index([tenantId, category])
  @@map("price_items")
}

/// A price from a day on. The newest one on or before a date applies, a branch's own before the clinic-wide one. Rows are never edited once in force (a change is a new row), so whatever was charged keeps its price.
model PriceItemPrice {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceItemId   String
  priceItem     PriceItem @relation(fields: [priceItemId], references: [id], onDelete: Cascade)
  /// One of the clinic's locations (a branch); null: every branch without a price of its own.
  clinicId      String?
  clinic        Clinic?   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  amount        Int
  /// The first day it applies: that day's start on the clinic clock.
  effectiveFrom DateTime
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, priceItemId, effectiveFrom])
  @@map("price_item_prices")
}
